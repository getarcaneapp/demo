<!DOCTYPE html>
<html lang="en">
<head>
    <title><%= websiteName %></title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" type="text/css"  href="/demo-kuma/main.css" />
</head>
<body>

<div id="app" v-cloak>

    <div class="main" v-if="!iframeSrc || zooming" :class="{ 'is-zooming': zooming }">
        <div class="entry"  v-if="showEntry">
            <h2><%= websiteName %></h2>
            <p class="mt-4">
                This is a demo of <%= websiteName %>. You can use this demo to try out the software before installing it on your own server.
            </p>
            <button class="btn btn-primary btn-big" @click="start">Start Demo</button>
        </div>

        <div v-if="showEnd">
            <h2>Demo has Ended</h2>
            <p class="mt-4">
                Your demo has ended.
            </p>
            <button class="btn btn-primary btn-big" @click="start">Start a new demo</button>
        </div>

        <div class="busy" v-if="busy">
            <h2>{{ busy.title }}</h2>
            <p class="mt-4">{{ busy.message }}</p>
            <p class="mt-2" v-if="busy.retryIn > 0">Retrying in {{ busy.retryIn }}s…</p>
            <button class="btn btn-primary btn-big mt-3" @click="start">Try now</button>
        </div>

        <div class="loading" v-if="loading">
            <svg class="arcane-loader" viewBox="0 0 179.837 172.133" role="img" aria-label="Loading">
                <g transform="translate(-457.5,-292.86667)">
